# ==========================================
# GitHub API (Fase 03)
# ==========================================
# Token de acceso personal para leer repos públicos en build time
# Crear en: https://github.com/settings/tokens
GITHUB_TOKEN=

# ==========================================
# Hackatime API (Fase 03)
# ==========================================
# API key para mostrar horas de código
# Obtener en: https://hackatime.hackclub.com
HACKATIME_API_KEY=

# ==========================================
# Sanity CMS (Fase 06)
# ==========================================
# Crear proyecto en: https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ==========================================
# Resend (Fase 07)
# ==========================================
# Para envío de emails del formulario de contacto
# Crear API key en: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_EMAIL_TO=hola@josht.xyz

# ==========================================
# Notas
# ==========================================
# 1. Este archivo SÍ va al repo (plantilla pública)
# 2. El archivo .env.local NO va al repo (valores reales)
# 3. Copia este archivo como .env.local y rellena los valores
